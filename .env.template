# Database
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# API
API_PORT=

# Modo de ejecución: development | production
# Selecciona qué dockerfile/target usa cada servicio:
#   - task_api_dev / task_react_dev (development) -> HMR + bind mount
#   - task_api_prod / task_react_prod (production) -> build + nginx
MODE=development
COMPOSE_PROFILES=${MODE:-development}

# React (dev -> Vite :5173 | prod -> nginx :80)
REACT_PORT=5173
REACT_PROD_PORT=8080