generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum activity {
  bug
  feature
  improvement
  task
  documentation
}

enum task_state {
  backlog
  to_do       @map("to do")
  in_progress @map("in progress")
  review
  done
}

enum priority {
  must
  should
  could
  wont
}

enum sprint_state {
  planned
  active
  completed
  cancelled
}

// ============================================
// Models
// ============================================

model project {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(30)
  description String?
  created_at  DateTime @default(now()) @db.Date

  sprints sprint[]
}

model app_user {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(30)
  created_at DateTime @default(now()) @db.Date

  reported_tasks task[] @relation("reporter")
  assigned_tasks task[] @relation("assignee")
}

model sprint {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(30)
  start_date DateTime     @default(now()) @db.Date
  end_date   DateTime?    @db.Date
  status     sprint_state @default(planned)
  project_id Int

  project project @relation(fields: [project_id], references: [id])
  tasks   task[]
}

model task {
  id          Int        @id @default(autoincrement())
  summary     String?    @db.VarChar(150)
  description String?
  activity    activity?
  status      task_state @default(backlog)
  priority    priority   @default(should)
  created_at  DateTime   @default(now()) @db.Date
  closed_at   DateTime?  @db.Date
  sprint_id   Int?
  reporter_id Int?
  assignee_id Int?

  sprint   sprint?   @relation(fields: [sprint_id], references: [id])
  reporter app_user? @relation("reporter", fields: [reporter_id], references: [id])
  assignee app_user? @relation("assignee", fields: [assignee_id], references: [id])

  dependents   precondition[] @relation("dependent")
  dependencies precondition[] @relation("independent")
}

model precondition {
  id                  Int @id @default(autoincrement())
  dependent_task_id   Int
  independent_task_id Int

  dependent_task   task @relation("dependent", fields: [dependent_task_id], references: [id])
  independent_task task @relation("independent", fields: [independent_task_id], references: [id])

  @@unique([dependent_task_id, independent_task_id])
}
